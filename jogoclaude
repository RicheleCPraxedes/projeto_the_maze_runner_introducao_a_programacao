    items = [
        ("▲ Atalho",     LIGHT_GREEN, lx,       ly + 24),
        ("▼ Armadilha",  RED,         lx + 160, ly + 24),
        ("♥ Safe Haven", TEAL,        lx + 320, ly + 24),
        ("⊘ Perde Turno",ORANGE,      lx + 480, ly + 24),
        ("☠ Griever",    PURPLE,      lx,       ly + 50),
        ("✦ Teleporte",  BLUE,        lx + 160, ly + 50),
        ("◄ Inversão",   RED,         lx + 320, ly + 50),
        ("★ Saída",      AMBER,       lx + 480, ly + 50),
    ]
    for label, col, tx, ty in items:
        draw_text(screen, label, font_small, col, tx, ty)

def draw_player_panels():
    """Painéis laterais com info dos jogadores."""
    px_start = 790
    for i, p in enumerate(players):
        py_start = 120 + i * 270
        is_current = (i == current_player and game_state == "waiting")
        border = AMBER if is_current else BORDER_COL
        bg = (25, 55, 25) if is_current else PANEL_COLOR
        draw_rounded_rect(screen, bg, (px_start, py_start, 290, 230), radius=14, border=2, border_color=border)

        # Nome
        draw_text_center(screen, p["name"].upper(), font_big, p["color"], px_start + 145, py_start + 28)

        # HP Corações
        draw_text(screen, "HP:", font_med, WHITE, px_start + 20, py_start + 58)
        for h in range(5):
            col = RED if h < p["hp"] else DARK_GRAY
            draw_text(screen, "♥", font_big, col, px_start + 60 + h * 38, py_start + 53)

        # Posição
        draw_text(screen, f'Casa: {p["pos"]} / 30', font_med, WHITE, px_start + 20, py_start + 100)

        # Barra de progresso
        bar_w = 250
        filled = int(bar_w * p["pos"] / 30)
        draw_rounded_rect(screen, DARK_GRAY, (px_start + 20, py_start + 128, bar_w, 16), radius=8)
        if filled > 0:
            draw_rounded_rect(screen, p["color"], (px_start + 20, py_start + 128, filled, 16), radius=8)
        draw_text(screen, "INÍCIO", font_tiny, GRAY, px_start + 20, py_start + 148)
        draw_text(screen, "SAÍDA", font_tiny, GRAY, px_start + 230, py_start + 148)

        if p["skip_turn"]:
            draw_text_center(screen, "⊘ PERDE TURNO", font_small, ORANGE, px_start + 145, py_start + 175)

        if is_current:
            draw_text_center(screen, "◄ SUA VEZ ►", font_small, AMBER, px_start + 145, py_start + 205)

def draw_dice_panel():
    """Painel do dado e mensagens."""
    dx, dy = 790, 600
    draw_rounded_rect(screen, PANEL_COLOR, (dx, dy, 290, 120), radius=12, border=1, border_color=BORDER_COL)

    # Dado
    draw_dice(screen, dice_value, dx + 10, dy + 10, size=70)

    # Mensagem do dado
    if dice_value:
        draw_text(screen, f'Dado: {dice_value}', font_big, AMBER, dx + 100, dy + 20)

def draw_message_panel():
    """Painel de mensagens do jogo."""
    mx, my = 50, 580
    draw_rounded_rect(screen, PANEL_COLOR, (mx, my, 725, 110), radius=12, border=1, border_color=BORDER_COL)
    draw_text(screen, "[ LOG DO LABIRINTO ]", font_med, AMBER, mx + 16, my + 10)
    for i, line in enumerate(message_lines[-3:]):
        draw_text(screen, line, font_small, WHITE, mx + 16, my + 35 + i * 22)

def draw_roll_button():
    """Botão de rolar dado."""
    bx, by, bw, bh = 790, 720, 290, 45
    can_roll = game_state == "waiting"
    col  = GREEN if can_roll else DARK_GRAY
    bcol = LIGHT_GREEN if can_roll else GRAY
    draw_rounded_rect(screen, col, (bx, by, bw, bh), radius=10, border=2, border_color=bcol)
    label = "🎲  ROLAR DADO" if can_roll else "Aguarde..."
    draw_text_center(screen, label, font_big, WHITE if can_roll else GRAY, bx + bw // 2, by + bh // 2)
    return pygame.Rect(bx, by, bw, bh)

def draw_gameover():
    overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
    overlay.fill((0, 0, 0, 180))
    screen.blit(overlay, (0, 0))

    bx, by, bw, bh = WIDTH // 2 - 250, HEIGHT // 2 - 140, 500, 280
    draw_rounded_rect(screen, (20, 50, 20), (bx, by, bw, bh), radius=20, border=3, border_color=AMBER)

    draw_text_center(screen, "[ FIM DO JOGO ]", font_title, AMBER, WIDTH // 2, by + 50)
    draw_text_center(screen, f'VENCEDOR: {winner}', font_big, LIGHT_GREEN, WIDTH // 2, by + 110)
    draw_text_center(screen, "Pressione R para reiniciar", font_med, WHITE, WIDTH // 2, by + 170)
    draw_text_center(screen, "ou ESC para sair.", font_med, GRAY, WIDTH // 2, by + 200)

def draw_title():
    draw_text_center(screen, "THE MAZE RUNNER — JOGO DE TABULEIRO", font_title, AMBER, WIDTH // 2, 45)
    pygame.draw.line(screen, BORDER_COL, (50, 75), (WIDTH - 50, 75), 2)

def reset_game():
    global current_player, dice_value, game_state, message_lines, winner
    for p in players:
        p["pos"]       = 0
        p["hp"]        = 5
        p["skip_turn"] = False
    current_player = 0
    dice_value     = None
    game_state     = "waiting"
    winner         = None
    message_lines  = ["Jogo reiniciado!", "Vez de Thomas. Clique em ROLAR DADO."]

# ─── Loop principal ───────────────────────────────────────────────────────────
running = True
roll_btn = None

while running:
    dt = clock.tick(60)

    # ── Eventos ──────────────────────────────────────────────────────────────
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False
            if event.key == pygame.K_r and game_state == "gameover":
                reset_game()
            if event.key == pygame.K_SPACE and game_state == "waiting":
                # Rolar dado via teclado
                dice_value = roll_dice()
                p = players[current_player]
                p["pos"] = min(p["pos"] + dice_value, TOTAL_SQUARES - 1)
                message_lines = [
                    f'{p["name"]} rolou {dice_value}!',
                    f'Moveu para a casa {p["pos"]}.'
                ]
                game_state = "moving"
                apply_effect(current_player)

        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if roll_btn and roll_btn.collidepoint(event.pos) and game_state == "waiting":
                dice_value = roll_dice()
                p = players[current_player]
                p["pos"] = min(p["pos"] + dice_value, TOTAL_SQUARES - 1)
                message_lines = [
                    f'{p["name"]} rolou {dice_value}!',
                    f'Moveu para a casa {p["pos"]}.'
                ]
                game_state = "moving"
                apply_effect(current_player)

            if game_state == "effect":
                next_turn()

    # ── Renderização ─────────────────────────────────────────────────────────
    screen.fill(BG_COLOR)

    # Grade de fundo sutil
    for gx in range(0, WIDTH, 40):
        pygame.draw.line(screen, (20, 50, 20), (gx, 0), (gx, HEIGHT), 1)
    for gy in range(0, HEIGHT, 40):
        pygame.draw.line(screen, (20, 50, 20), (0, gy), (WIDTH, gy), 1)

    draw_title()
    draw_board()
    draw_legend()
    draw_player_panels()
    draw_dice_panel()
    draw_message_panel()
    roll_btn = draw_roll_button()

    # Instrução de clique após efeito
    if game_state == "effect":
        draw_text_center(screen, "[ Clique para continuar ]", font_med, AMBER, WIDTH // 2 - 100, HEIGHT - 20)

    if game_state == "gameover":
        draw_gameover()

    pygame.display.flip()

pygame.quit()
