# ─── Posições do tabuleiro (serpentina) ──────────────────────────────────────
def build_board_positions():
    """Gera posições de casas em formato serpentina (vai e volta)."""
    positions = []
    board_x0 = 60
    board_y0 = 120
    cols      = 10
    rows      = 3
    cell_w    = 70
    cell_h    = 90
    total     = cols * rows

    for r in range(rows - 1, -1, -1):   # de baixo para cima
        row_range = range(cols) if r % 2 == 0 else range(cols - 1, -1, -1)
        for c in row_range:
            x = board_x0 + c * cell_w + cell_w // 2
            y = board_y0 + r * cell_h + cell_h // 2
            positions.append((x, y))
            if len(positions) >= TOTAL_SQUARES:
                return positions
    return positions

BOARD_POS = build_board_positions()

# ─── Funções auxiliares ───────────────────────────────────────────────────────
def draw_rounded_rect(surf, color, rect, radius=10, border=0, border_color=None):
    pygame.draw.rect(surf, color, rect, border_radius=radius)
    if border and border_color:
        pygame.draw.rect(surf, border_color, rect, border, border_radius=radius)

def draw_text_center(surf, text, font, color, cx, cy):
    s = font.render(text, True, color)
    surf.blit(s, (cx - s.get_width() // 2, cy - s.get_height() // 2))

def draw_text(surf, text, font, color, x, y):
    s = font.render(text, True, color)
    surf.blit(s, (x, y))

def get_effect(pos):
    return BOARD_EFFECTS.get(pos, None)

def effect_color(pos):
    e = get_effect(pos)
    if e:
        return e["color"]
    return DARK_GRAY

def roll_dice():
    return random.randint(1, 6)

def apply_effect(player_idx):
    global current_player, game_state, message_lines, winner
    p   = players[player_idx]
    pos = p["pos"]
    e   = get_effect(pos)

    if e is None:
        next_turn()
        return

    t = e["type"]
    desc = e["desc"]

    if t == "boost":
        steps = int(e["label"].split("+")[1].split(" ")[0])
        p["pos"] = min(p["pos"] + steps, TOTAL_SQUARES - 1)
        message_lines = [f'{p["name"]}: {desc}', f'Avançou para a casa {p["pos"]}!']
    elif t == "reverse":
        steps = int(e["label"].split(" ")[1])
        p["pos"] = max(p["pos"] - steps, 0)
        message_lines = [f'{p["name"]}: {desc}', f'Voltou para a casa {p["pos"]}!']
    elif t == "trap":
        steps = int(e["label"].split(" ")[1])
        p["pos"] = max(p["pos"] - steps, 0)
        message_lines = [f'{p["name"]}: {desc}', f'Voltou para a casa {p["pos"]}!']
    elif t == "skip":
        p["skip_turn"] = True
        message_lines = [f'{p["name"]}: {desc}', "Perderá o próximo turno!"]
    elif t == "heal":
        p["hp"] = min(p["hp"] + 1, 5)
        message_lines = [f'{p["name"]}: {desc}', f'HP: {p["hp"]}/5']
    elif t == "griever":
        p["hp"] -= 2
        message_lines = [f'{p["name"]}: {desc}', f'HP restante: {max(p["hp"],0)}/5']
        if p["hp"] <= 0:
            p["hp"] = 0
            message_lines.append(f'{p["name"]} foi eliminado! Derrota!')
            game_state = "gameover"
            winner = players[1 - player_idx]["name"]
            return
    elif t == "teleport":
        dest = int(e["desc"].split("casa ")[1].split(".")[0])
        p["pos"] = dest
        message_lines = [f'{p["name"]}: {desc}', f'Teletransportado para casa {dest}!']
    elif t == "end":
        message_lines = [f'🏆 {p["name"]} escapou do Labirinto!', "VITÓRIA! Parabéns!"]
        game_state = "gameover"
        winner = p["name"]
        return
    elif t == "start":
        message_lines = [f'{p["name"]} está no início.', "Boa sorte no Labirinto!"]

    game_state = "effect"

def next_turn():
    global current_player, game_state, message_lines
    current_player = 1 - current_player
    p = players[current_player]
    if p["skip_turn"]:
        p["skip_turn"] = False
        message_lines = [f'{p["name"]} perde este turno!', f'Vez de {players[1-current_player]["name"]}.']
        current_player = 1 - current_player
    game_state = "waiting"
    message_lines = [f'Vez de {players[current_player]["name"]}!', "Clique em ROLAR DADO."]

# ─── Desenho do dado ──────────────────────────────────────────────────────────
DICE_DOTS = {
    1: [(0.5, 0.5)],
    2: [(0.25, 0.25), (0.75, 0.75)],
    3: [(0.25, 0.25), (0.5, 0.5), (0.75, 0.75)],
    4: [(0.25, 0.25), (0.75, 0.25), (0.25, 0.75), (0.75, 0.75)],
    5: [(0.25, 0.25), (0.75, 0.25), (0.5, 0.5), (0.25, 0.75), (0.75, 0.75)],
    6: [(0.25, 0.2), (0.75, 0.2), (0.25, 0.5), (0.75, 0.5), (0.25, 0.8), (0.75, 0.8)],
}

def draw_dice(surf, value, x, y, size=80):
    draw_rounded_rect(surf, (240, 230, 210), (x, y, size, size), radius=14, border=3, border_color=GRAY)
    if value and value in DICE_DOTS:
        for dx, dy in DICE_DOTS[value]:
            cx = int(x + dx * size)
            cy = int(y + dy * size)
            pygame.draw.circle(surf, DARK_GRAY, (cx, cy), size // 10)

# ─── Tabuleiro ────────────────────────────────────────────────────────────────
def draw_board():
    # Fundo do tabuleiro
    board_rect = (45, 108, 720, 295)
    draw_rounded_rect(screen, (18, 45, 18), board_rect, radius=16, border=2, border_color=BORDER_COL)

    for i, (bx, by) in enumerate(BOARD_POS):
        size = 58
        rx   = bx - size // 2
        ry   = by - size // 2
        col  = effect_color(i)

        # Sombra
        pygame.draw.rect(screen, (0, 0, 0, 100), (rx + 3, ry + 3, size, size), border_radius=8)
        # Célula
        draw_rounded_rect(screen, col, (rx, ry, size, size), radius=8, border=2, border_color=BORDER_COL)

        # Número da casa
        num_s = font_tiny.render(str(i), True, WHITE if col != AMBER else BLACK)
        screen.blit(num_s, (rx + 4, ry + 3))

        # Ícone do efeito
        e = get_effect(i)
        if e:
            icon_map = {
                "boost": "▲", "trap": "▼", "heal": "♥", "skip": "⊘",
                "griever": "☠", "teleport": "✦", "reverse": "◄", "end": "★", "start": "⚑"
            }
            icon = icon_map.get(e["type"], "")
            if icon:
                ic = font_med.render(icon, True, WHITE if col not in [AMBER, LIGHT_GREEN] else BLACK)
                screen.blit(ic, (bx - ic.get_width() // 2, by - ic.get_height() // 2 + 6))

    # Jogadores sobre o tabuleiro
    for pi, p in enumerate(players):
        if 0 <= p["pos"] < len(BOARD_POS):
            px, py = BOARD_POS[p["pos"]]
            offset = -10 if pi == 0 else 10
            pygame.draw.circle(screen, BLACK, (px + offset + 1, py + 1), 14)
            pygame.draw.circle(screen, p["color"], (px + offset, py), 14)
            pygame.draw.circle(screen, WHITE, (px + offset, py), 14, 2)
            lbl = font_tiny.render(p["emoji"], True, WHITE)
            screen.blit(lbl, (px + offset - lbl.get_width() // 2, py - lbl.get_height() // 2))

